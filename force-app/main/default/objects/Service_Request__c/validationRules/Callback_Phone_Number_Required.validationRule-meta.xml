<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Callback_Phone_Number_Required</fullName>
    <active>true</active>
    <description>Callback Phone Number is required for Emergency Requests</description>
    <errorConditionFormula>AND (
  ISPICKVAL (Priority__c, &apos;Emergency&apos;),
  ISBLANK (Callback_Phone_Number__c)
)</errorConditionFormula>
    <errorMessage>Please enter Callback Phone Number</errorMessage>
</ValidationRule>
